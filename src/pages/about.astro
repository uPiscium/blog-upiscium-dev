---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
---
<!-- Prototype copy: replace biography and career text after design approval. -->
<BaseLayout title={`About — ${site.name}`} description="upisciumのプロフィール、設計思想、技術領域。">
  <main id="main" class="page-main container about">
    <header class="page-header profile"><div class="avatar" aria-hidden="true">η</div><div><p class="eyebrow">/about</p><h1>upiscium</h1><p class="muted">本名：［デザイン承認後に記載］</p><p class="lede">{site.role}</p></div></header>
    <section class="section"><SectionHeading path="01 / principle" title="Design Principle" /><div class="principle panel"><p>{site.principle}</p><p class="muted">便利な抽象化を使いながらも、制御の境界・失敗の仕方・観測の方法を隠しすぎない。長く育つソフトウェアのための、私の基本姿勢です。</p></div></section>
    <section class="section"><SectionHeading path="02 / now" title="Current Focus" /><div class="grid focus-grid"><article class="card"><p class="path">Graphics / Software</p><h3>Terreate</h3><dl><dt>目的</dt><dd>Vulkanを用いた描画APIの設計検証。</dd><dt>現在の状態</dt><dd>基礎機能を実装中。</dd><dt>次のマイルストーン</dt><dd>基本的な描画APIの完成</dd><dt>updatedAt</dt><dd>2026-08（仮）</dd></dl></article><article class="card"><p class="path">Local AI / System</p><h3>PROJECT-KAGYA</h3><dl><dt>目的</dt><dd>人格形成と自意識の創発を研究・検証するローカルAIシステム。</dd><dt>現在の状態</dt><dd>デプロイ準備中。</dd><dt>次のマイルストーン</dt><dd>ローカル環境への安定デプロイ</dd><dt>updatedAt</dt><dd>2026-08（仮）</dd></dl><a class="command-link" href="/works/project-kagya/">View project</a></article></div></section>
    <section class="section"><SectionHeading path="03 / history" title="Career" /><ol class="timeline"><li><span class="year">2023年3月</span><div><h3>長野県上田高等学校 卒業</h3></div></li><li><span class="year">2023年4月</span><div><h3>東京農工大学 工学部 知能情報システム工学科 入学</h3></div></li><li><span class="year">2026年4月</span><div><h3>藤田桂英研究室 配属</h3><p class="muted">マルチエージェントシステムを用いた社会的相互作用の研究</p></div></li></ol></section>
    <section class="section"><SectionHeading path="04 / tools" title="Technology Stack" /><div class="stack-grid"><div><h3>Systems & Graphics</h3><p><strong>C++</strong> — 描画基盤 / Terreate</p><p><strong>Vulkan</strong> — 明示的GPU API / Terreate</p><p><strong>OpenGL</strong> — 旧描画実装 / 旧Terreate</p></div><div><h3>AI & Research</h3><p><strong>Python</strong> — 実験・推論 / VillagerAgent, PROJECT-KAGYA</p><p>Multi-Agent Systems — 社会的相互作用研究 / VillagerAgent</p></div><div><h3>Infrastructure</h3><p><strong>NixOS</strong> — 再現可能な環境 / Home Lab</p><p>Linux — 開発・運用基盤 / PROJECT-KAGYA</p></div><div><h3>Application Development</h3><p>Java / NeoForge — MOD実装 / Frontier Protocol</p><p>TypeScript / Astro — 静的サイト / upiscium.dev</p></div></div></section>
    <section class="section"><SectionHeading path="05 / deepening" title="Currently Deepening" /><ul class="deepening"><li>Docker／コンテナ運用</li><li>Proxmox／仮想化</li><li>ネットワーク設計</li></ul></section>
    <section class="section"><SectionHeading path="06 / lab" title="Home Lab Summary" /><div class="panel lab"><h3>再現可能な検証・運用環境</h3><p class="muted">NixOS、コンテナ、仮想化を軸にローカル基盤を運用しています。IP、ホスト名、サービス構成などの詳細は公開せず、今後の <code>/lab</code> またはBlogで一般化した知見を扱います。</p></div></section>
    <section class="section links"><SectionHeading path="07 / elsewhere" title="External Links" /><div>{site.socials.map((social) => social.href !== '#' ? <a href={social.href} rel="me">{social.label}</a> : <span class="muted">{social.label}（準備中）</span>)}</div></section>
  </main>
</BaseLayout>
<style>
  .profile{display:flex;align-items:center;gap:2rem}.avatar{display:grid;width:7rem;aspect-ratio:1;place-items:center;border:1px solid var(--line);border-radius:50%;color:var(--star-blue);font-size:2.5rem;background:var(--surface)}.profile h1{margin:.2rem 0}.principle { padding:clamp(1.5rem,4vw,3rem); }.principle p:first-child { margin:0 0 1rem; color:var(--star-blue); font-size:clamp(1.4rem,3vw,2.4rem); line-height:1.5; }.focus-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.focus-grid dl{font-size:.82rem}.focus-grid dt{color:var(--star-blue)}.focus-grid dd{margin:0 0 .8rem;color:var(--text-secondary)}.timeline { display:grid; gap:0; margin:0; padding:0; list-style:none; }.timeline li { display:grid; grid-template-columns:8rem 1fr; gap:1rem; padding:1.4rem 0; border-bottom:1px solid var(--line); }.timeline h3 { margin:0; }.year { color:var(--flower-red); font-family:var(--font-ui); }.stack-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1rem; }.stack-grid>div { padding:1.2rem; border-left:2px solid var(--star-blue); background:rgba(16,23,43,.55); }.stack-grid h3 { margin-top:0; }.stack-grid p { color:var(--text-secondary); }.deepening{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;padding:0;list-style:none}.deepening li{border:1px solid var(--line);padding:1rem}.links>div { display:flex; flex-wrap:wrap; gap:1.5rem; } @media(max-width:640px) { .profile{align-items:start;flex-direction:column}.focus-grid,.stack-grid,.deepening { grid-template-columns:1fr; }.timeline li { grid-template-columns:1fr; gap:.3rem; } }
</style>
