---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import CodePreview from '../../components/CodePreview.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await post.render();
const allPosts = (await getCollection('blog')).filter((item) => !item.data.draft).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const related = allPosts.filter((item) => item.slug !== post.slug && (item.data.category === post.data.category || item.data.tags.some((tag) => post.data.tags.includes(tag)))).slice(0, 3);
---
<BaseLayout title={`${post.data.title} // SIGNAL`} description={post.data.description}>
  <main id="main" class="container page-main">
    <p class="path"><a href="/blog/">{`./blog/${post.slug}`}</a></p>
    <div class="article-layout">
      <TableOfContents headings={headings} />
      <article class="article">
        <header class="article-header"><p class="eyebrow">{post.data.category} / log</p><h1>{post.data.title}</h1><p class="lede">{post.data.description}</p><div class="meta"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>{post.data.updatedDate && <span>updated {post.data.updatedDate.toISOString().slice(0, 10)}</span>}<span>{post.data.tags.map((tag) => `#${tag}`).join(' ')}</span></div></header>
        <div class="prose"><Content /></div>
        {post.slug === 'vulkan-sync-design' && <CodePreview file="src/lib/route.ts" language="typescript" highlight={[2, 3]} diff code={'-const mode = "legacy";\n+const mode = "stream";\n+export const route = createRoute(mode);'} />}
      </article>
    </div>
    {related.length > 0 && <section class="related section"><div class="section-heading"><h2>Related posts</h2></div><div class="grid grid-3">{related.map((item) => <a class="card" href={`/blog/${item.slug}/`}><p class="eyebrow">{item.data.category}</p><h3>{item.data.title}</h3><p>{item.data.description}</p></a>)}</div></section>}
  </main>
</BaseLayout>
<script is:inline>
  const links = [...document.querySelectorAll('.toc-desktop a, .toc-mobile a')];
  const sections = links.map((link) => document.querySelector(link.getAttribute('href'))).filter(Boolean);
   const updateLocation = () => { let current = sections[0]; for (const section of sections) if (section.getBoundingClientRect().top <= 140) current = section; links.forEach((link) => { if (link.getAttribute('href') === `#${current?.id}`) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current'); }); };
  addEventListener('scroll', updateLocation, { passive: true }); updateLocation();
</script>
<style>
  .article-layout{display:grid;grid-template-columns:190px minmax(0,800px);gap:3rem;align-items:start;justify-content:center}.article{min-width:0}.article-header{margin-bottom:3rem}.article-header h1{margin:.5rem 0 1rem}.article-header .meta{margin-top:1.5rem}.prose{font-size:1.02rem;line-height:1.9}.prose :global(h2),.prose :global(h3){scroll-margin-top:7rem;margin-top:3rem}.prose :global(p),.prose :global(ul),.prose :global(ol),.prose :global(blockquote){margin-block:1.35rem}.prose :global(a){text-decoration:underline}.prose :global(a[href^="http"]::after){content:' ↗';font-size:.75em}.prose :global(blockquote){border-left:2px solid var(--flower-red);padding-left:1rem;color:var(--text-secondary)}.prose :global(pre),.prose :global(table){overflow-x:auto;background:#060a16;border:1px solid var(--line)}.prose :global(pre){width:min(960px,calc(100vw - 3rem));padding:1rem}.prose :global(table){display:block;width:max-content;max-width:min(960px,calc(100vw - 3rem));border-collapse:collapse}.prose :global(th),.prose :global(td){border:1px solid var(--line);padding:.6rem}.related{max-width:800px;margin-left:auto;margin-right:auto}@media(max-width:800px){.article-layout{display:block}.related{margin-left:0}.article-header{margin-bottom:2rem}}
</style>
