---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { categories } from '../../data/posts';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const representatives = categories.map((category) => {
  const categoryPosts = posts.filter((post) => post.data.category === category);
  return { category, post: categoryPosts.find((post) => post.data.featured) ?? categoryPosts[0] };
}).filter((item) => item.post);
---
<BaseLayout title="Blog // SIGNAL" description="Engineering notes and research logs.">
  <main id="main" class="container page-main">
    <header class="page-header"><p class="eyebrow">/blog</p><h1>Recent posts</h1><p class="lede">Design, systems, and the small decisions behind useful software.</p></header>
    <section class="section"><div class="section-heading"><h2>Categories</h2><span class="muted">representative logs</span></div><div class="grid grid-3">{representatives.map(({ category, post }) => post && <PostCard title={post.data.title} description={post.data.description} href={`/blog/${post.slug}/`} pubDate={post.data.pubDate.toISOString().slice(0, 10)} updatedDate={post.data.updatedDate?.toISOString().slice(0, 10)} category={category} tags={post.data.tags} />)}</div></section>
    <section class="section"><div class="section-heading"><h2>All articles</h2><span class="muted">{posts.length} entries / 9 per page</span></div><div class="grid grid-3">{posts.map((post) => <PostCard title={post.data.title} description={post.data.description} href={`/blog/${post.slug}/`} pubDate={post.data.pubDate.toISOString().slice(0, 10)} updatedDate={post.data.updatedDate?.toISOString().slice(0, 10)} category={post.data.category} tags={post.data.tags} />)}</div><nav class="pagination" aria-label="ページネーション（デザイン確認用）"><button disabled>← newer</button><span aria-current="page">01</span><button disabled>02</button><button disabled>03</button><button disabled>older →</button></nav></section>
  </main>
</BaseLayout>
<style>.pagination{display:flex;justify-content:center;gap:1.5rem;margin-top:2rem;align-items:center;color:var(--text-secondary)}.pagination button{border:1px solid var(--line);background:transparent;color:inherit;padding:.5rem .8rem}.pagination button:disabled{opacity:.45}</style>
