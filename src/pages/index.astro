---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkCard from '../components/WorkCard.astro';
import PostCard from '../components/PostCard.astro';
import { site, focusAreas } from '../data/site';
import { works } from '../data/works';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).filter((post) => !post.data.draft).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
const featuredWorks = works.slice(0, 3);
---
<!-- Prototype copy: replace presentation text after design approval. -->
<BaseLayout title={site.title} description={site.description}>
  <main id="main" class="page-main home container">
    <section class="hero section" aria-labelledby="hero-title">
      <svg class="hero-decoration star" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 4 57 43 96 50 57 57 50 96 43 57 4 50 43 43Z" fill="none" stroke="currentColor" /></svg>
      <svg class="hero-decoration flower" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 50c-25-6-30-27-14-32 9-3 14 9 14 32Zm0 0c6-25 27-30 32-14 3 9-9 14-32 14Zm0 0c25 6 30 27 14 32-9 3-14-9-14-32Zm0 0c-6 25-27 30-32 14-3-9-14-14-32-14Z" fill="none" stroke="currentColor" /><circle cx="50" cy="50" r="5" fill="currentColor" /></svg>
      <p class="eyebrow">portfolio / knowledge base</p><h1 id="hero-title">upiscium</h1>
      <p class="sr-only">{site.role}。{site.principle}</p>
      <div class="typing" aria-hidden="true"><span>&gt; </span><span data-typing data-text={`${site.role}\n${site.principle}`}>{site.role}<br />{site.principle}</span><span class="cursor">_</span></div>
      <p class="lede hero-copy">開発・研究・運用の過程と、そこから得た知見を記録・公開しています。<br />C++／VulkanによるCG、AI、インフラを横断して、システムの設計と実装に取り組んでいます。</p>
      <div class="hero-links"><a class="command-link" href="/about/">view about</a><a class="command-link" href="#works">explore works</a><a class="command-link" href="/blog/">read blog</a></div>
    </section>
    <section class="section"><SectionHeading path="/about" title="About Summary" href="/about/" linkLabel="read profile" /><div class="summary-grid"><p class="summary-lede">抽象化の向こう側を説明できること。<br />使う人と作る人が、システムを理解し続けられること。</p><p class="muted">フロントエンドから低レイヤー、ローカルAI、ホームラボまで。境界を越えるときも、設計の理由を追える形にしておくことを大切にしています。</p></div></section>
    <section id="works" class="section"><SectionHeading path="/works" title="Featured Works" href="/works/" linkLabel="view all works" /><div class="grid grid-3">{featuredWorks.map((work) => <WorkCard work={work} detailed />)}</div></section>
    <section class="section"><SectionHeading path="/focus" title="Technical Focus" /><div class="grid grid-4">{focusAreas.map((area) => <article class="focus-card card"><p class="path">{area.title}</p><p>{area.description}</p><ul>{area.technologies.map((technology) => <li>{technology}</li>)}</ul><p class="project">Project: {area.project}</p></article>)}</div></section>
    <section class="section"><SectionHeading path="/blog" title="Recent Posts" href="/blog/" linkLabel="read all posts" /><div class="grid grid-3">{posts.map((post) => <PostCard title={post.data.title} description={post.data.description} href={`/blog/${post.slug}/`} pubDate={post.data.pubDate.toISOString().slice(0, 10)} updatedDate={post.data.updatedDate?.toISOString().slice(0, 10)} category={post.data.category} tags={post.data.tags} />)}</div></section>
    <section class="section contact-band"><div><p class="path">/contact</p><h2>Contact Summary</h2><p class="muted">技術交流・共同研究・OSS連携、仕事・開発依頼、登壇・執筆・取材についての連絡先をまとめています。</p></div><a class="command-link" href="/contact/">contact methods</a></section>
  </main>
</BaseLayout>
<script is:inline>
  const target = document.querySelector('[data-typing]');
  if (target) { const text = target.getAttribute('data-text') || ''; const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; const played = sessionStorage.getItem('upiscium-hero-typed'); if (!reduced && !played) { target.textContent = ''; sessionStorage.setItem('upiscium-hero-typed', 'true'); let i = 0; const type = () => { target.textContent = text.slice(0, i++); if (i <= text.length) window.setTimeout(type, 24); }; type(); } }
</script>
<style>
  .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); }.hero { position:relative; min-height:34rem; display:flex; flex-direction:column; justify-content:center; overflow:hidden; }.hero h1 { max-width:14ch; margin:.45rem 0 1.2rem; font-size:clamp(2.6rem,8vw,6.6rem); }.hero h1 span { color:var(--star-blue); }.hero-copy { max-width:58rem; }.hero-decoration { position:absolute; pointer-events:none; }.star { width:9rem; top:8%; right:9%; color:var(--star-blue); opacity:.16; }.flower { width:8rem; right:25%; bottom:10%; color:var(--flower-red); opacity:.2; }.typing { min-height:4.2rem; margin-top:1.5rem; color:var(--text-secondary); font-family:var(--font-ui); font-size:.84rem; line-height:1.7; white-space:pre-wrap; }.typing>span:first-child { color:var(--flower-red); }.cursor { color:var(--star-blue); animation:blink 1s steps(1) infinite; }.hero-links { display:flex; flex-wrap:wrap; gap:1.4rem; margin-top:1rem; }.summary-grid { display:grid; grid-template-columns:1fr 1fr; gap:3rem; }.summary-lede { font-size:clamp(1.2rem,2.5vw,1.8rem); line-height:1.6; }.focus-card p { margin-top:0; }.focus-card ul { display:flex; flex-wrap:wrap; gap:.4rem; padding:0; list-style:none; color:var(--star-blue); font-size:.78rem; }.focus-card li::before { content:'#'; color:var(--flower-red); }.contact-band { display:flex; align-items:end; justify-content:space-between; gap:2rem; border-top:1px solid var(--line); }.contact-band h2 { margin:.3rem 0; } @keyframes blink { 50% { opacity:0; } } @media(max-width:640px) { .summary-grid { grid-template-columns:1fr; gap:1rem; }.contact-band { align-items:start; flex-direction:column; }.star { right:-2rem; } }
</style>
