---
interface Heading { depth: number; slug: string; text: string; }
const { headings = [] } = Astro.props as { headings?: Heading[] };
---
<details class="toc-mobile">
  <summary>On this page</summary>
  <nav aria-label="Table of contents"><ul>{headings.map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>
</details>
<nav class="toc-desktop" aria-label="Table of contents">
  <p class="eyebrow">contents</p>
  <ul>{headings.map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
</nav>
<style>
  .toc-desktop { position: sticky; top: 7rem; align-self: start; }
  ul { list-style: none; margin: 0; padding: 0; } li { margin: .45rem 0; font-size: .82rem; }
  li.depth-3 { padding-left: .8rem; } a { color: var(--text-secondary); text-decoration: none; } a:hover, a[aria-current="location"] { color: var(--star-blue); }
  .toc-mobile { display: none; margin-bottom: 1.5rem; border: 1px solid var(--line); padding: .75rem 1rem; }
  @media (max-width: 800px) { .toc-desktop { display: none; } .toc-mobile { display: block; } }
</style>
